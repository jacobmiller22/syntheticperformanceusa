---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dealerConfig } from '../config/dealer';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = "AMSOIL™ Synthetic Oil & Lubricants | Save Up to 25% | Authorized Dealer",
  description = "Save up to 25% on factory-direct AMSOIL synthetic motor oil, transmission fluids, and filters. Authorized Dealer serving customers nationwide with fast shipping from 13 distribution centers.",
  canonicalUrl = Astro.url.href,
  ogImage = "/images/06-hero-products-showcase.avif"
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content={dealerConfig.businessName} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />

  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Structured Data: AutoPartsStore / LocalBusiness -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AutoPartsStore",
    "name": `${dealerConfig.businessName} - Authorized AMSOIL Dealer`,
    "description": description,
    "url": dealerConfig.siteUrl,
    "telephone": dealerConfig.phone,
    "email": dealerConfig.email,
    "priceRange": "$$",
    "areaServed": ["United States", "Canada"],
    "brand": {
      "@type": "Brand",
      "name": "AMSOIL"
    }
  })} />
</head>
<body class="min-h-screen flex flex-col bg-[#0a0e17] text-slate-100 selection:bg-red-600 selection:text-white">
  <Header currentPath={currentPath} />
  <main class="flex-grow">
    <slot />
  </main>
  <Footer />
</body>
</html>
