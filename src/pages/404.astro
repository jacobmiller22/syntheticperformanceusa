---
import Layout from "../layouts/Layout.astro";
import { dealerConfig } from "../config/dealer";
---

<Layout
  title={`Page Not Found`}
  description="The page you are looking for could not be found."
>
  <div
    class="py-24 bg-slate-950 text-center min-h-[60vh] flex flex-col items-center justify-center"
  >
    <div class="container mx-auto px-4 max-w-lg space-y-6">
      <div class="text-6xl font-black text-red-600 font-['Montserrat']">
        404
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white font-['Montserrat']">
        Page Not Found
      </h1>
      <p class="text-sm text-slate-400">
        We couldn't find the page or product you were looking for. Let's get you
        back on track:
      </p>
      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2"
      >
        <a
          href="/"
          class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-xl text-xs uppercase tracking-wider transition-colors"
        >
          Return Home
        </a>
        <a
          href="/go/lookup"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto bg-slate-800 hover:bg-slate-700 text-white font-semibold px-6 py-3 rounded-xl text-xs transition-colors border border-slate-700"
        >
          Vehicle Lookup Guide &rarr;
        </a>
      </div>
    </div>
  </div>
</Layout>
