---
---

<section class="py-20 bg-gradient-to-b from-slate-900 to-slate-950 border-b border-slate-800 relative overflow-hidden">
  <!-- Glowing subtle badge in background -->
  <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -left-20 -top-20 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 rounded-3xl border border-slate-700/80 p-8 sm:p-12 shadow-2xl">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Left: Perks and description -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center space-x-2 bg-amber-400/10 border border-amber-400/30 rounded-full px-3 py-1 text-xs text-amber-400 font-bold uppercase tracking-wider">
            <span>★</span>
            <span>Wholesale Membership Perks</span>
          </div>

          <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight font-['Montserrat']">
            Become an <span class="text-red-500">AMSOIL</span> Preferred Customer
            <span class="block text-xl sm:text-2xl font-bold text-slate-300 mt-1">
              And Save Up To 25% On Every Order
            </span>
          </h2>

          <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
            Why pay full retail? AMSOIL’s Preferred Customer (P.C.) program gives you wholesale pricing on every synthetic lubricant, fluid, and filter—starting at just <strong class="text-white">$10</strong>.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2 text-sm text-slate-200">
            <div class="flex items-center space-x-2.5">
              <div class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">✓</div>
              <span><strong>Up to 25% discount</strong> on all products</span>
            </div>
            <div class="flex items-center space-x-2.5">
              <div class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">✓</div>
              <span><strong>Free shipping</strong> on orders over $100</span>
            </div>
            <div class="flex items-center space-x-2.5">
              <div class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">✓</div>
              <span><strong>$5 back</strong> for every $100 spent</span>
            </div>
            <div class="flex items-center space-x-2.5">
              <div class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">✓</div>
              <span><strong>$5 Birthday voucher</strong> every year</span>
            </div>
            <div class="flex items-center space-x-2.5">
              <div class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">✓</div>
              <span><strong>Free annual renewal</strong> at $500 spend</span>
            </div>
            <div class="flex items-center space-x-2.5">
              <div class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">✓</div>
              <span><strong>Exclusive promotions</strong> &amp; free gear</span>
            </div>
          </div>

          <div class="pt-4 flex flex-col sm:flex-row items-center gap-4">
            <a 
              href="/go/save25"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto flex items-center justify-center space-x-2 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-extrabold px-8 py-4 rounded-xl text-sm uppercase tracking-wider shadow-lg shadow-red-950/60 transition-all hover:scale-105"
            >
              <span>Join Now For Just $10 &rarr;</span>
            </a>
            <div class="text-xs text-slate-400 text-center sm:text-left">
              Pays for itself on your first order! No minimum purchases.
            </div>
          </div>

        </div>

        <!-- Right: Showcase card -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="w-full max-w-sm bg-slate-950 rounded-2xl border border-slate-800 p-6 text-center space-y-4 shadow-xl">
            <div class="text-xs uppercase font-bold tracking-widest text-slate-400">Membership Tier</div>
            <div class="text-3xl font-black text-white font-['Montserrat']">
              Preferred Customer
            </div>
            <div class="text-4xl font-extrabold text-red-500 font-['Montserrat']">
              $10 <span class="text-base text-slate-400 font-normal">/ 6 Months</span>
            </div>
            <div class="text-xs text-slate-400">or $20 for 1 full year with free gift</div>
            
            <div class="p-4 bg-slate-900 rounded-xl border border-slate-800 text-left space-y-2 text-xs">
              <div class="font-bold text-white uppercase tracking-wider text-[11px]">Example Savings:</div>
              <div class="flex justify-between text-slate-300">
                <span>Signature Series 5W-30 (Case):</span>
                <span class="text-emerald-400 font-bold">Save ~$35.00</span>
              </div>
              <div class="flex justify-between text-slate-300">
                <span>Shipping on $120 order:</span>
                <span class="text-emerald-400 font-bold">FREE ($14 value)</span>
              </div>
              <div class="border-t border-slate-800 pt-2 flex justify-between text-white font-bold">
                <span>Instant Net Savings:</span>
                <span class="text-emerald-400">+$39.00</span>
              </div>
            </div>

            <a 
              href="/go/save25"
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full bg-slate-800 hover:bg-slate-700 text-white py-3 rounded-xl text-xs font-bold uppercase tracking-wider transition-colors border border-slate-700"
            >
              Claim Your 25% Discount &rarr;
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
