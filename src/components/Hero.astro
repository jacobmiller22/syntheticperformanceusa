---
---

<section class="relative overflow-hidden bg-slate-950 pt-8 pb-16 lg:py-24 border-b border-slate-800">
  <!-- Subtle gradient glow backdrop -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(0,40,85,0.4),rgba(255,255,255,0))] pointer-events-none"></div>

  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <div class="inline-flex items-center space-x-2 bg-slate-900/90 border border-slate-700/80 rounded-full px-3 py-1 text-xs text-slate-300 shadow-sm">
          <span class="flex h-2 w-2 rounded-full bg-red-500 animate-pulse"></span>
          <span class="font-bold text-red-400 uppercase tracking-wider text-[11px]">Factory Direct</span>
          <span class="text-slate-500">|</span>
          <span>13 US &amp; Canadian Warehouses</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight font-['Montserrat']">
          The First In Synthetics<span class="text-red-600">®</span>.
          <span class="block text-2xl sm:text-4xl lg:text-5xl font-bold text-slate-300 mt-2">
            Engineered For Maximum Protection.
          </span>
        </h1>

        <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Order 100% synthetic motor oils, transmission fluids, and Ea® filtration directly from AMSOIL with <strong class="text-white">wholesale savings up to 25%</strong> as a Preferred Customer.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <!-- Primary: Vehicle Lookup -->
          <a 
            href="/go/lookup" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto flex items-center justify-center space-x-2 bg-red-600 hover:bg-red-700 text-white font-bold px-7 py-3.5 rounded-xl text-sm uppercase tracking-wider shadow-lg shadow-red-950/50 hover:shadow-red-900/60 transition-all duration-200 hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <span>Lookup Your Vehicle</span>
          </a>

          <!-- Secondary: Preferred Customer -->
          <a 
            href="/preferred-customer" 
            class="w-full sm:w-auto flex items-center justify-center space-x-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-semibold px-6 py-3.5 rounded-xl text-sm transition-all duration-200 hover:-translate-y-0.5"
          >
            <span>Save 25% Today (P.C.)</span>
            <span class="text-amber-400 text-xs font-bold uppercase ml-1 px-1.5 py-0.5 bg-amber-400/10 rounded border border-amber-400/30">$10/yr</span>
          </a>

          <!-- Tertiary: All Products -->
          <a 
            href="/go/all" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xs text-slate-400 hover:text-white font-semibold underline underline-offset-4 py-2"
          >
            Browse Full Catalog &rarr;
          </a>
        </div>

        <!-- Trust Badges List -->
        <div class="pt-6 border-t border-slate-800/80 grid grid-cols-3 gap-4 text-center lg:text-left">
          <div>
            <div class="text-lg sm:text-xl font-black text-white font-['Montserrat']">25,000 MI</div>
            <div class="text-[11px] text-slate-400 uppercase tracking-wider">Drain Intervals</div>
          </div>
          <div>
            <div class="text-lg sm:text-xl font-black text-white font-['Montserrat']">25% OFF</div>
            <div class="text-[11px] text-slate-400 uppercase tracking-wider">Wholesale Savings</div>
          </div>
          <div>
            <div class="text-lg sm:text-xl font-black text-white font-['Montserrat']">FREE SHIP</div>
            <div class="text-[11px] text-slate-400 uppercase tracking-wider">On Orders $100+</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Product Showcase -->
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="relative w-full max-w-lg">
          <!-- Ambient backlight glow -->
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-tr from-red-600/30 to-blue-600/30 blur-2xl opacity-60"></div>
          
          <div class="relative bg-gradient-to-b from-slate-900 to-slate-950 rounded-2xl border border-slate-800 p-4 shadow-2xl">
            <img 
              src="/images/06-hero-products-showcase.avif" 
              alt="AMSOIL Synthetic Lubricants Lineup" 
              class="w-full h-auto rounded-xl object-cover hover:scale-[1.02] transition-transform duration-300"
              loading="eager"
            />
            
            <div class="mt-4 p-3 bg-slate-900/90 rounded-xl border border-slate-800 flex items-center justify-between text-xs">
              <div class="flex items-center space-x-2">
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                <span class="text-slate-300 font-medium">Fast 1-2 Business Day Shipping</span>
              </div>
              <a href="/go/all" target="_blank" rel="noopener noreferrer" class="text-red-400 font-bold hover:underline">
                Order Now &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
