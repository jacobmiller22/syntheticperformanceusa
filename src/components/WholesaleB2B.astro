---
---

<section class="py-16 bg-slate-900/40 border-b border-slate-800">
  <div class="container mx-auto px-4 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-block text-xs font-bold uppercase tracking-widest text-red-500 mb-2">
        Wholesale &amp; Business Opportunities
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight font-['Montserrat']">
        AMSOIL FOR BUSINESSES &amp; DEALERS
      </h2>
      <p class="text-sm sm:text-base text-slate-400 mt-2">
        Whether you operate a fleet of vehicles, own an automotive repair shop, or want to start your own independent dealership business, AMSOIL has dedicated wholesale programs.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card 1: Commercial Accounts -->
      <div class="bg-slate-950 rounded-2xl border border-slate-800 p-6 flex flex-col justify-between hover:border-slate-700 transition-all duration-300">
        <div>
          <div class="w-10 h-10 rounded-xl bg-blue-600/10 text-blue-400 flex items-center justify-center font-bold mb-4 border border-blue-600/20">
            🚚
          </div>
          <h3 class="text-xl font-bold text-white font-['Montserrat']">Commercial Fleet Accounts</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            For businesses that operate commercial vehicles, construction equipment, trucking fleets, or municipal machinery. Buy at lowest commercial pricing, reduce oil changes, and extend equipment life.
          </p>
          <ul class="mt-4 space-y-1.5 text-xs text-slate-300">
            <li>• Bulk 55-gal drums, totes &amp; cases</li>
            <li>• Save 30% to 40% off retail prices</li>
            <li>• Net 30 terms available for qualified businesses</li>
            <li>• Dedicated technical lubricant support</li>
          </ul>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-800">
          <a 
            href="/go/commercial" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="block text-center bg-slate-800 hover:bg-slate-700 text-white py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-colors border border-slate-700"
          >
            Apply for Commercial Account &rarr;
          </a>
        </div>
      </div>

      <!-- Card 2: Retailer & Installer Accounts -->
      <div class="bg-slate-950 rounded-2xl border border-slate-800 p-6 flex flex-col justify-between hover:border-slate-700 transition-all duration-300">
        <div>
          <div class="w-10 h-10 rounded-xl bg-amber-600/10 text-amber-400 flex items-center justify-center font-bold mb-4 border border-amber-600/20">
            🏪
          </div>
          <h3 class="text-xl font-bold text-white font-['Montserrat']">Retail On-The-Shelf</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            For auto parts stores, powersports dealerships, motorcycle shops, hardware stores, and quick-lube service centers that want to stock and install AMSOIL products.
          </p>
          <ul class="mt-4 space-y-1.5 text-xs text-slate-300">
            <li>• High-margin retail product sales</li>
            <li>• Listed on official AMSOIL Dealer/Installer Locator</li>
            <li>• Free merchandising displays &amp; signage</li>
            <li>• Free shipping on qualifying stock orders</li>
          </ul>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-800">
          <a 
            href="/go/retail" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="block text-center bg-slate-800 hover:bg-slate-700 text-white py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-colors border border-slate-700"
          >
            Apply for Retail Account &rarr;
          </a>
        </div>
      </div>

      <!-- Card 3: Dealership Opportunity -->
      <div class="bg-slate-950 rounded-2xl border border-red-900/40 p-6 flex flex-col justify-between hover:border-red-600/60 transition-all duration-300 relative">
        <div class="absolute -top-3 right-6 bg-red-600 text-white text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full shadow">
          Business Opportunity
        </div>
        <div>
          <div class="w-10 h-10 rounded-xl bg-red-600/10 text-red-500 flex items-center justify-center font-bold mb-4 border border-red-600/20">
            💼
          </div>
          <h3 class="text-xl font-bold text-white font-['Montserrat']">Become an AMSOIL Dealer</h3>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Start your own independent dealership. Sell AMSOIL lubricants part-time or full-time. Earn retail profits and ongoing commissions on customers, accounts, and retail stores.
          </p>
          <ul class="mt-4 space-y-1.5 text-xs text-slate-300">
            <li>• Low startup cost (under $50)</li>
            <li>• No inventory requirements or quotas</li>
            <li>• AMSOIL ships orders directly to your customers</li>
            <li>• Comprehensive digital training in the Dealer Zone</li>
          </ul>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-800">
          <a 
            href="/become-a-dealer" 
            class="block text-center bg-red-600 hover:bg-red-700 text-white py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-colors shadow-md shadow-red-950/40"
          >
            Learn About Dealerships &rarr;
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
