---
const vehicleCategories = [
  {
    title: 'Auto & Light Truck',
    subtitle: 'Gasoline & light diesel cars, SUVs, pickups',
    image: '/images/vehicles/07-vehicle-auto-light-truck.avif',
    href: '/go/auto-truck'
  },
  {
    title: 'Motorcycles',
    subtitle: 'V-Twin, metric cruisers, sport bikes',
    image: '/images/vehicles/08-vehicle-motorcycle.avif',
    href: '/go/motorcycle'
  },
  {
    title: 'ATV & UTV',
    subtitle: 'Side-by-sides, quads, off-road utility',
    image: '/images/vehicles/09-vehicle-atv.avif',
    href: '/go/atv-utv'
  },
  {
    title: 'Marine & Outboard',
    subtitle: 'Inboards, outboards, sterndrives, PWC',
    image: '/images/vehicles/12-vehicle-marine-outboard.avif',
    href: '/go/marine'
  },
  {
    title: 'Snowmobiles',
    subtitle: '2-stroke & 4-stroke extreme sub-zero formulas',
    image: '/images/vehicles/11-vehicle-snowmobile.avif',
    href: '/go/snowmobile'
  },
  {
    title: 'Heavy-Duty Diesel',
    subtitle: 'Commercial fleets, semi-trucks, tractors',
    image: '/images/vehicles/14-vehicle-heavy-duty.avif',
    href: '/go/heavy-duty'
  },
  {
    title: 'Dirt Bikes',
    subtitle: 'High-RPM motocross & trail competition',
    image: '/images/30-hero-dirt-bike.avif',
    href: '/go/dirt-bike'
  },
  {
    title: 'Small Engine & Mowers',
    subtitle: 'Lawnmowers, generators, commercial turf',
    image: '/images/03-herosmall-equipment.avif',
    href: '/go/small-engine'
  }
];
---

<section class="py-16 bg-slate-900/60 border-b border-slate-800">
  <div class="container mx-auto px-4 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-block text-xs font-bold uppercase tracking-widest text-red-500 mb-2">
        Equipment Lookup Guide
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight font-['Montserrat']">
        FIND AMSOIL PRODUCTS FOR YOUR VEHICLE
      </h2>
      <p class="text-sm sm:text-base text-slate-400 mt-3">
        Select your vehicle or equipment type below to instantly lookup exact oil viscosity, fluid capacities, and filter numbers verified for your machine.
      </p>
    </div>

    <!-- Vehicles Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {vehicleCategories.map(v => (
        <a 
          href={v.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative bg-slate-950 rounded-2xl border border-slate-800 overflow-hidden hover:border-red-600/60 transition-all duration-300 hover:shadow-xl hover:shadow-red-950/20 hover:-translate-y-1 flex flex-col"
        >
          <!-- Image container -->
          <div class="aspect-4/3 w-full overflow-hidden bg-slate-900 relative">
            <img 
              src={v.image} 
              alt={v.title}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
          </div>

          <!-- Content -->
          <div class="p-4 flex flex-col flex-grow justify-between">
            <div>
              <h3 class="font-bold text-white text-base group-hover:text-red-400 transition-colors font-['Montserrat']">
                {v.title}
              </h3>
              <p class="text-xs text-slate-400 mt-1 line-clamp-2">
                {v.subtitle}
              </p>
            </div>
            
            <div class="mt-4 flex items-center text-xs font-semibold text-red-500 group-hover:text-red-400 pt-2 border-t border-slate-800/80">
              <span>View Products</span>
              <svg class="w-3.5 h-3.5 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Big Lookup Guide Banner -->
    <div class="mt-12 bg-gradient-to-r from-blue-950 via-slate-900 to-blue-950 rounded-2xl p-6 sm:p-8 border border-blue-900/40 text-center flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
      <div class="text-left">
        <h3 class="text-xl sm:text-2xl font-bold text-white font-['Montserrat']">Not sure which oil your vehicle takes?</h3>
        <p class="text-sm text-slate-300 mt-1">Use AMSOIL's interactive Vehicle Lookup tool with your exact Year, Make, Model &amp; Engine.</p>
      </div>
      <a 
        href="/go/lookup"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 flex items-center space-x-2 bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3.5 rounded-xl text-sm uppercase tracking-wider shadow-lg shadow-red-950/50 transition-all hover:scale-105"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <span>Open Vehicle Lookup Guide</span>
      </a>
    </div>

  </div>
</section>
