---
import { dealerConfig } from '../config/dealer';

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 border-t border-slate-800 text-slate-400 text-sm mt-20">
  <div class="container mx-auto px-4 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Column 1: Brand & Dealer Info -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center space-x-3">
          <img src="/images/34-amsoil-logo-main.avif" alt="AMSOIL Logo" class="h-8 w-auto brightness-95" />
          <span class="text-xs uppercase font-bold tracking-widest text-slate-300 border-l border-slate-700 pl-3">
            Authorized Dealer
          </span>
        </div>
        <p class="text-xs leading-relaxed text-slate-400 max-w-md">
          Providing motorists, fleet managers, and motorsport enthusiasts with factory-direct AMSOIL synthetic lubricants, filters, and high-performance fluids with fast shipping across the United States and Canada.
        </p>
        <div class="space-y-1.5 text-xs text-slate-300 pt-2">
          <div class="flex items-center space-x-2">
            <span class="font-semibold text-white">Dealer:</span>
            <span>{dealerConfig.dealerName} (ZO #{dealerConfig.zoNumber})</span>
          </div>
          <div class="flex items-center space-x-2">
            <span class="font-semibold text-white">Phone:</span>
            <a href={`tel:${dealerConfig.phone}`} class="hover:text-red-400 transition-colors">{dealerConfig.phone}</a>
          </div>
          <div class="flex items-center space-x-2">
            <span class="font-semibold text-white">Email:</span>
            <a href={`mailto:${dealerConfig.email}`} class="hover:text-red-400 transition-colors">{dealerConfig.email}</a>
          </div>
          <div class="flex items-center space-x-2">
            <span class="font-semibold text-white">Distribution:</span>
            <span>13 Warehouses (US &amp; Canada)</span>
          </div>
        </div>
      </div>

      <!-- Column 2: Products -->
      <div class="space-y-3">
        <h4 class="text-white font-bold text-xs uppercase tracking-wider">Top Products</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/go/motor-oil" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Synthetic Motor Oil</a></li>
          <li><a href="/go/transmission-fluid" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Transmission Fluids</a></li>
          <li><a href="/go/filtration" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Ea® Oil Filters &amp; By-Pass</a></li>
          <li><a href="/go/fuel-additives" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Fuel Additives &amp; Cleaners</a></li>
          <li><a href="/go/gear-lube" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Severe Gear® Lubes</a></li>
          <li><a href="/go/grease" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Synthetic Greases</a></li>
          <li><a href="/go/all" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors font-semibold text-red-400">View All Products &rarr;</a></li>
        </ul>
      </div>

      <!-- Column 3: Vehicle Guides & Tools -->
      <div class="space-y-3">
        <h4 class="text-white font-bold text-xs uppercase tracking-wider">Guides &amp; Tools</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/go/lookup" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Vehicle Lookup Guide</a></li>
          <li><a href="/go/auto-truck" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Auto &amp; Light Truck</a></li>
          <li><a href="/go/motorcycle" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Motorcycle Lookups</a></li>
          <li><a href="/go/atv-utv" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">ATV &amp; UTV Lookups</a></li>
          <li><a href="/go/marine" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Marine &amp; Outboard</a></li>
          <li><a href="/go/heavy-duty" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Heavy-Duty Diesel Fleet</a></li>
          <li><a href="/go/free-catalog" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Request Free Catalog</a></li>
        </ul>
      </div>

      <!-- Column 4: Programs & Opportunities -->
      <div class="space-y-3">
        <h4 class="text-white font-bold text-xs uppercase tracking-wider">Programs</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/preferred-customer" class="hover:text-white transition-colors font-semibold text-amber-400">Save 25% (Preferred Customer)</a></li>
          <li><a href="/become-a-dealer" class="hover:text-white transition-colors">Become an AMSOIL Dealer</a></li>
          <li><a href="/commercial-wholesale" class="hover:text-white transition-colors">Commercial Fleet Accounts</a></li>
          <li><a href="/commercial-wholesale#retail" class="hover:text-white transition-colors">Retailer / Installer Accounts</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About Brandon's Dealership</a></li>
          <li><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
        </ul>
      </div>

    </div>

    <!-- Legal Compliance Disclaimer & Copyright -->
    <div class="border-t border-slate-800/80 mt-12 pt-8 text-[11px] text-slate-500 space-y-3">
      <p class="leading-relaxed">
        <strong>Independent Dealer Disclaimer:</strong> {dealerConfig.dealerName} is an Independent Authorized Dealer of AMSOIL INC. products (ZO #{dealerConfig.zoNumber}). All orders placed through links on this website are processed, billed, and fulfilled directly by AMSOIL INC. from its corporate distribution centers. AMSOIL™, The First In Synthetics®, Signature Series®, Ea®, and Severe Gear® are registered trademarks of AMSOIL INC. Superior, WI.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-between pt-2 border-t border-slate-900 text-slate-500">
        <p>&copy; {currentYear} {dealerConfig.businessName}. All Rights Reserved.</p>
        <div class="flex space-x-4 mt-2 sm:mt-0">
          <a href="/privacy" class="hover:text-slate-400 transition-colors">Privacy Policy</a>
          <span>&bull;</span>
          <a href="/about" class="hover:text-slate-400 transition-colors">Contact</a>
          <span>&bull;</span>
          <a href="/go/save25" target="_blank" rel="noopener noreferrer" class="hover:text-slate-400 transition-colors">Preferred Customer Terms</a>
        </div>
      </div>
    </div>

  </div>
</footer>
